---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import graphData from '../../data/knowledge/supply-chain-nodes.json';

const { title, subtitle, version, last_updated, nodes, edges, legend } = graphData;

// ── 硬編碼排版位置（季度更新只改 JSON，不動這裡）──────────────────────
const NW = 138;           // node width
const NH = 52;            // node height
const NW2 = NW / 2;       // half width
const NH2 = NH / 2;       // half height

const pos: Record<string, { cx: number; cy: number }> = {
  // Layer 0  (band y=30..120, node cy=75)
  TSMC:    { cx: 96,  cy: 75  },
  SKH:     { cx: 288, cy: 75  },
  Samsung: { cx: 480, cy: 75  },
  MU:      { cx: 672, cy: 75  },
  AMKR:   { cx: 864, cy: 75  },
  // Layer 1A  (band y=152..300, sublayer cy=195)
  NVDA:    { cx: 155, cy: 195 },
  AMD:     { cx: 315, cy: 195 },
  // Layer 1B  (same band, sublayer cy=268)
  AVGO:    { cx: 505, cy: 268 },
  MRVL:    { cx: 672, cy: 268 },
  QCOM:    { cx: 848, cy: 268 },
  // Layer 2  (band y=358..458, node cy=408)
  GOOG:    { cx: 80,  cy: 408 },
  META:    { cx: 240, cy: 408 },
  AMZN:    { cx: 400, cy: 408 },
  MSFT:    { cx: 560, cy: 408 },
  xAI:     { cx: 720, cy: 408 },
  ORCL:    { cx: 880, cy: 408 },
  // Layer 3  (band y=476..570, node cy=523)
  COHR:    { cx: 120, cy: 523 },
  GLW:     { cx: 360, cy: 523 },
  ANET:    { cx: 600, cy: 523 },
  VRT:     { cx: 840, cy: 523 },
};

// ── 邊線樣式 ────────────────────────────────────────────────────────────
const edgeStyle: Record<string, {
  stroke: string; width: number; dash: string; marker: string;
}> = {
  manufactures_at: { stroke: '#16a34a', width: 1.5, dash: '',    marker: 'url(#arr-green)'  },
  supplies_to:     { stroke: '#9ca3af', width: 1.2, dash: '',    marker: 'url(#arr-gray)'   },
  investment:      { stroke: '#ea580c', width: 2,   dash: '7 3', marker: 'url(#arr-orange)' },
  competition:     { stroke: '#dc2626', width: 1.5, dash: '5 3', marker: 'url(#arr-red)'    },
};

// ── 節點顏色（依 layer / sublayer）──────────────────────────────────────
const nodeColor: Record<string, { fill: string; stroke: string; text: string }> = {
  '0':  { fill: '#f0fdf4', stroke: '#16a34a', text: '#14532d' },
  '1A': { fill: '#eff6ff', stroke: '#2563eb', text: '#1e3a8a' },
  '1B': { fill: '#faf5ff', stroke: '#7c3aed', text: '#4c1d95' },
  '2':  { fill: '#fff7ed', stroke: '#c2410c', text: '#7c2d12' },
  '3':  { fill: '#f1f5f9', stroke: '#475569', text: '#1e293b' },
};

function getColor(n: typeof nodes[0]) {
  const key = (n as any).sublayer ?? n.layer;
  return nodeColor[key] ?? nodeColor['3'];
}

// ── 邊線路徑計算 ────────────────────────────────────────────────────────
function edgePath(fromId: string, toId: string, type: string): string {
  const s = pos[fromId];
  const t = pos[toId];
  if (!s || !t) return '';

  if (type === 'competition') {
    // 同層弧線，往下突出
    const arc = Math.max(s.cy, t.cy) + 46;
    return `M ${s.cx} ${s.cy + NH2} C ${s.cx} ${arc} ${t.cx} ${arc} ${t.cx} ${t.cy + NH2}`;
  }
  if (type === 'investment') {
    // 同層弧線，往上突出
    const arc = Math.min(s.cy, t.cy) - 38;
    return `M ${s.cx + NW2} ${s.cy} C ${s.cx + NW2 + 50} ${arc} ${t.cx - NW2 - 50} ${arc} ${t.cx - NW2} ${t.cy}`;
  }
  // 跨層：底部 → 頂部的 bezier
  const x1 = s.cx, y1 = s.cy + NH2;
  const x2 = t.cx, y2 = t.cy - NH2;
  const dy = (y2 - y1) * 0.42;
  return `M ${x1} ${y1} C ${x1} ${y1 + dy} ${x2} ${y2 - dy} ${x2} ${y2}`;
}
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead
      title={`${title} — Xompass`}
      description={subtitle}
    />
    <style>
      body { background: #f9fafb; }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

      .page-header { margin-bottom: 1.75rem; }
      .page-header h1 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #111827;
        margin: 0 0 0.35rem;
        letter-spacing: -0.03em;
      }
      .subtitle {
        color: #6b7280;
        font-size: 0.9rem;
        margin: 0 0 0.6rem;
      }
      .meta {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        color: #9ca3af;
      }
      .version {
        background: #e0f2fe;
        color: #0369a1;
        padding: 0.15rem 0.5rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.72rem;
      }
      .sep { color: #d1d5db; }

      .graph-container {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 1rem;
        overflow-x: auto;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
      }
      .graph-container svg { display: block; min-width: 720px; }

      .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        margin-top: 1.2rem;
        padding: 0.9rem 1.2rem;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        font-size: 0.8rem;
        color: #374151;
      }
      .legend-item { display: flex; align-items: center; gap: 0.45rem; }
      .legend-item svg { flex-shrink: 0; }

      .note {
        margin-top: 1rem;
        font-size: 0.75rem;
        color: #9ca3af;
        text-align: right;
      }

      @media (max-width: 640px) {
        main { padding: 1rem 0.75rem 3rem; }
        .page-header h1 { font-size: 1.2rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>

      <div class="page-header">
        <h1>{title}</h1>
        <p class="subtitle">{subtitle}</p>
        <div class="meta">
          <span class="version">{version}</span>
          <span class="sep">·</span>
          <span>更新日期 {last_updated}</span>
          <span class="sep">·</span>
          <span>Xompass Research</span>
        </div>
      </div>

      <div class="graph-container">
        <svg
          viewBox="0 0 960 615"
          width="100%"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label={title}
          style="font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;"
        >
          <defs>
            <!-- Arrow markers, one per colour -->
            <marker id="arr-green"  viewBox="0 0 10 8" refX="9" refY="4"
                    markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#16a34a"/>
            </marker>
            <marker id="arr-gray"   viewBox="0 0 10 8" refX="9" refY="4"
                    markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#9ca3af"/>
            </marker>
            <marker id="arr-orange" viewBox="0 0 10 8" refX="9" refY="4"
                    markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#ea580c"/>
            </marker>
            <marker id="arr-red"    viewBox="0 0 10 8" refX="9" refY="4"
                    markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#dc2626"/>
            </marker>
          </defs>

          <!-- ── Layer bands ──────────────────────────────────────────── -->
          <!-- Layer 0 -->
          <rect x="10" y="26" width="940" height="96" rx="10"
                fill="#f0fdf4" stroke="#bbf7d0" stroke-width="1"/>
          <text x="20" y="44" font-size="8.5" fill="#16a34a" font-weight="700"
                letter-spacing="0.08em">
            LAYER 0 — 製造 ／ 記憶體
          </text>

          <!-- Layer 1 -->
          <rect x="10" y="148" width="940" height="162" rx="10"
                fill="#f5f3ff" stroke="#ddd6fe" stroke-width="1"/>
          <text x="20" y="166" font-size="8.5" fill="#6d28d9" font-weight="700"
                letter-spacing="0.08em">
            LAYER 1 — GPU ／ Custom ASIC
          </text>
          <!-- Sublayer vertical divider -->
          <line x1="428" y1="160" x2="428" y2="300"
                stroke="#c4b5fd" stroke-width="1" stroke-dasharray="4 3"/>
          <text x="215" y="304" text-anchor="middle" font-size="8" fill="#2563eb">
            1A — GPU
          </text>
          <text x="665" y="304" text-anchor="middle" font-size="8" fill="#7c3aed">
            1B — Custom ASIC
          </text>

          <!-- Layer 2 -->
          <rect x="10" y="352" width="940" height="100" rx="10"
                fill="#fff7ed" stroke="#fed7aa" stroke-width="1"/>
          <text x="20" y="370" font-size="8.5" fill="#c2410c" font-weight="700"
                letter-spacing="0.08em">
            LAYER 2 — 需求商（Hyperscaler）
          </text>

          <!-- Layer 3 -->
          <rect x="10" y="472" width="940" height="106" rx="10"
                fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
          <text x="20" y="490" font-size="8.5" fill="#475569" font-weight="700"
                letter-spacing="0.08em">
            LAYER 3 — 互聯 ／ 電力基礎設施
          </text>

          <!-- ── Edges（先渲染，節點蓋在上方）──────────────────────── -->
          {edges.map((e: any) => {
            const st = edgeStyle[e.type] ?? edgeStyle.supplies_to;
            const d = edgePath(e.from, e.to, e.type);
            if (!d) return null;
            return (
              <path
                d={d}
                fill="none"
                stroke={st.stroke}
                stroke-width={st.width}
                stroke-dasharray={st.dash || undefined}
                marker-end={st.marker}
                opacity="0.55"
              />
            );
          })}

          <!-- ── Nodes ────────────────────────────────────────────────── -->
          {nodes.map((n: any) => {
            const p = pos[n.id];
            if (!p) return null;
            const c = getColor(n);
            const nx = p.cx - NW2;
            const ny = p.cy - NH2;
            // Ticker badge (only if ticker differs from id)
            const showTicker = n.ticker && n.ticker !== n.id && n.ticker !== n.name;
            return (
              <g>
                <rect x={nx} y={ny} width={NW} height={NH} rx="7"
                      fill={c.fill} stroke={c.stroke} stroke-width="1.5"/>
                <text x={p.cx} y={p.cy - 6} text-anchor="middle"
                      font-size="12.5" font-weight="700" fill={c.text}>
                  {n.name}{showTicker ? ` (${n.ticker})` : ''}
                </text>
                <text x={p.cx} y={p.cy + 11} text-anchor="middle"
                      font-size="9" fill={c.text} opacity="0.72">
                  {n.desc}
                </text>
              </g>
            );
          })}

          <!-- Xompass watermark -->
          <text x="950" y="610" text-anchor="end"
                font-size="8" fill="#d1d5db" letter-spacing="0.05em">
            © Xompass Research
          </text>
        </svg>
      </div>

      <!-- Legend -->
      <div class="legend">
        {legend.map((item: any) => (
          <div class="legend-item">
            <svg width="36" height="12" viewBox="0 0 36 12" fill="none">
              {item.dash
                ? <line x1="0" y1="6" x2="36" y2="6"
                        stroke={item.color} stroke-width="2" stroke-dasharray="7 3"/>
                : <line x1="0" y1="6" x2="36" y2="6"
                        stroke={item.color} stroke-width="2"/>
              }
              <polygon points="30,3 36,6 30,9" fill={item.color}/>
            </svg>
            <span>{item.label}</span>
          </div>
        ))}
        <div class="legend-item" style="margin-left: auto; color: #9ca3af; font-size: 0.72rem;">
          資料來源：公開財報、產業研究 — 僅供參考，不構成投資建議
        </div>
      </div>

      <p class="note">每季更新 · 節點說明如有疑問請來信 bargisula@gmail.com</p>

    </main>
    <Footer />
  </body>
</html>
