---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import graphData from '../../data/knowledge/space-launch-nodes.json';

const { title, subtitle, version, last_updated, nodes, edges, legend } = graphData;

const NW = 134;
const NH = 50;
const NW2 = NW / 2;
const NH2 = NH / 2;

// Layer 0 (demand) y=66   — 3 nodes
// Layer 1 (launch) y=186  — 1 node (RKLB)
// Layer 2 (prime)  y=306  — 4 nodes
// Layer 3 (satcom) y=426  — 6 nodes
// Layer 4 (comp)   y=546  — 4 nodes
const pos: Record<string, { cx: number; cy: number }> = {
  NASA:          { cx: 160,  cy: 66  },
  DOD_LAUNCH:    { cx: 480,  cy: 66  },
  COMMERCIAL_SAT:{ cx: 800,  cy: 66  },

  RKLB:          { cx: 480,  cy: 186 },

  LMT:           { cx: 120,  cy: 306 },
  BA:            { cx: 360,  cy: 306 },
  NOC:           { cx: 600,  cy: 306 },
  RTX:           { cx: 840,  cy: 306 },

  ASTS:          { cx: 80,   cy: 426 },
  VSAT:          { cx: 240,  cy: 426 },
  IRDM:          { cx: 400,  cy: 426 },
  GSAT:          { cx: 560,  cy: 426 },
  SPIR:          { cx: 720,  cy: 426 },
  PL:            { cx: 880,  cy: 426 },

  AJRD:          { cx: 120,  cy: 546 },
  MOG:           { cx: 360,  cy: 546 },
  KTOS:          { cx: 600,  cy: 546 },
  HEI:           { cx: 840,  cy: 546 },
};

const edgeStyle: Record<string, { stroke: string; width: number; dash: string; marker: string }> = {
  supplies_to:   { stroke: '#9ca3af', width: 1.2, dash: '',    marker: 'url(#arr-gray)'  },
  competes_with: { stroke: '#dc2626', width: 1.5, dash: '5 3', marker: 'url(#arr-red)'   },
};

const nodeColor: Record<string, { fill: string; stroke: string; text: string }> = {
  demand: { fill: '#f0fdf4', stroke: '#16a34a', text: '#14532d' },
  '1':    { fill: '#eff6ff', stroke: '#2563eb', text: '#1e3a8a' },
  prime:  { fill: '#fff7ed', stroke: '#c2410c', text: '#7c2d12' },
  satcom: { fill: '#faf5ff', stroke: '#7c3aed', text: '#4c1d95' },
  data:   { fill: '#f0f9ff', stroke: '#0369a1', text: '#0c4a6e' },
  '4':    { fill: '#f1f5f9', stroke: '#475569', text: '#1e293b' },
};

function getColor(n: any) {
  const key = n.sublayer ?? n.layer;
  return nodeColor[key] ?? nodeColor['4'];
}

function edgePath(fromId: string, toId: string, type: string): string {
  const s = pos[fromId];
  const t = pos[toId];
  if (!s || !t) return '';
  if (type === 'competes_with') {
    const arc = Math.max(s.cy, t.cy) + 44;
    return `M ${s.cx} ${s.cy + NH2} C ${s.cx} ${arc} ${t.cx} ${arc} ${t.cx} ${t.cy + NH2}`;
  }
  const x1 = s.cx, y1 = s.cy + NH2;
  const x2 = t.cx, y2 = t.cy - NH2;
  const dy = (y2 - y1) * 0.42;
  return `M ${x1} ${y1} C ${x1} ${y1 + dy} ${x2} ${y2 - dy} ${x2} ${y2}`;
}
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead
      title={`${title} — Xompass`}
      description={subtitle}
    />
    <style>
      body { background: #f9fafb; }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

      .page-header { margin-bottom: 1.5rem; }
      .page-header h1 {
        font-size: 1.6rem; font-weight: 800; color: #111827;
        margin: 0 0 0.35rem; letter-spacing: -0.03em;
      }
      .subtitle { color: #6b7280; font-size: 0.9rem; margin: 0 0 0.6rem; }
      .meta { display: flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; color: #9ca3af; }
      .version {
        background: #e0f2fe; color: #0369a1;
        padding: 0.15rem 0.5rem; border-radius: 20px;
        font-weight: 600; font-size: 0.72rem;
      }
      .sep { color: #d1d5db; }

      .description {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-left: 4px solid #7c3aed;
        border-radius: 8px;
        padding: 1.1rem 1.4rem;
        margin-bottom: 1.4rem;
        font-size: 0.875rem;
        color: #374151;
        line-height: 1.75;
      }
      .description p { margin: 0 0 0.7rem; }
      .description p:last-child { margin: 0; }
      .description .layers {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.6rem;
        margin-top: 0.9rem;
      }
      .layer-chip {
        display: flex; align-items: flex-start; gap: 0.5rem;
        background: #f9fafb; border: 1px solid #e5e7eb;
        border-radius: 6px; padding: 0.55rem 0.75rem;
        font-size: 0.8rem; line-height: 1.5;
      }
      .layer-chip .dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; margin-top: 3px; }
      .layer-chip strong { display: block; font-size: 0.78rem; color: #111827; }
      .layer-chip span { color: #6b7280; font-size: 0.77rem; }

      .graph-container {
        background: #fff; border: 1px solid #e5e7eb;
        border-radius: 12px; padding: 1rem;
        overflow-x: auto;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
      }
      .graph-container svg { display: block; min-width: 760px; }

      .legend {
        display: flex; flex-wrap: wrap; gap: 1.2rem;
        margin-top: 1.2rem; padding: 0.9rem 1.2rem;
        background: #fff; border: 1px solid #e5e7eb;
        border-radius: 10px; font-size: 0.8rem; color: #374151;
      }
      .legend-item { display: flex; align-items: center; gap: 0.45rem; }
      .legend-item svg { flex-shrink: 0; }

      .note { margin-top: 1rem; font-size: 0.75rem; color: #9ca3af; text-align: right; }

      @media (max-width: 640px) {
        main { padding: 1rem 0.75rem 3rem; }
        .page-header h1 { font-size: 1.2rem; }
        .description .layers { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>

      <div class="page-header">
        <h1>{title}</h1>
        <p class="subtitle">{subtitle}</p>
        <div class="meta">
          <span class="version">{version}</span>
          <span class="sep">·</span>
          <span>更新日期 {last_updated}</span>
          <span class="sep">·</span>
          <span>Xompass Research</span>
        </div>
      </div>

      <div class="description">
        <p>
          <strong>SpaceX（私有）是本圖的隱形錨點</strong>：Falcon 9 將發射成本從 1 億美元以上壓低至 6,700 萬美元，
          Starship 目標再砍 10 倍。所有上市公司的競爭地位，都要放在這個定價破壞背景下理解。
          RKLB 是唯一純發射上市標的；LMT / BA / NOC / RTX 依賴政府合約護城河；
          衛星通訊層（ASTS / VSAT / IRDM / GSAT）正面臨 Starlink LEO 的結構性侵蝕。
        </p>
        <div class="layers">
          <div class="layer-chip">
            <span class="dot" style="background:#16a34a;"></span>
            <div>
              <strong>Layer 0 — 需求端</strong>
              <span>NASA、美國國防部、商業衛星客戶。政府預算週期與商業星座 capex 是需求驅動力。</span>
            </div>
          </div>
          <div class="layer-chip">
            <span class="dot" style="background:#2563eb;"></span>
            <div>
              <strong>Layer 1 — 發射服務</strong>
              <span>RKLB（Rocket Lab）是唯一純發射上市股，小型衛星利基市場，Neutron 是下一個成長觸媒。</span>
            </div>
          </div>
          <div class="layer-chip">
            <span class="dot" style="background:#c2410c;"></span>
            <div>
              <strong>Layer 2 — 國防航太大廠</strong>
              <span>LMT / BA / NOC / RTX 依賴政府長期合約，太空業務佔比約 15-30%，護城河深但成長慢。</span>
            </div>
          </div>
          <div class="layer-chip">
            <span class="dot" style="background:#7c3aed;"></span>
            <div>
              <strong>Layer 3 — 衛星通訊與應用</strong>
              <span>ASTS（直連手機）是最高 beta；VSAT（GEO）是 Starlink 最直接受害者；IRDM / GSAT 利基防禦。</span>
            </div>
          </div>
          <div class="layer-chip">
            <span class="dot" style="background:#475569;"></span>
            <div>
              <strong>Layer 4 — 關鍵零組件</strong>
              <span>AJRD（引擎）、MOG（作動器）、KTOS（地面系統）、HEI（MRO）。政府合約穩定但成長受限。</span>
            </div>
          </div>
        </div>
      </div>

      <div class="graph-container">
        <svg
          viewBox="0 0 960 620"
          width="100%"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label={title}
          style="font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;"
        >
          <defs>
            <marker id="arr-gray" viewBox="0 0 10 8" refX="9" refY="4" markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#9ca3af"/>
            </marker>
            <marker id="arr-red" viewBox="0 0 10 8" refX="9" refY="4" markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#dc2626"/>
            </marker>
          </defs>

          <!-- Layer 0 band -->
          <rect x="10" y="26" width="940" height="80" rx="10" fill="#f0fdf4" stroke="#bbf7d0" stroke-width="1"/>
          <text x="20" y="43" font-size="8.5" fill="#16a34a" font-weight="700" letter-spacing="0.08em">
            LAYER 0 — 需求端
          </text>

          <!-- Layer 1 band -->
          <rect x="10" y="146" width="940" height="80" rx="10" fill="#eff6ff" stroke="#bfdbfe" stroke-width="1"/>
          <text x="20" y="163" font-size="8.5" fill="#2563eb" font-weight="700" letter-spacing="0.08em">
            LAYER 1 — 發射服務（唯一純發射上市股）
          </text>

          <!-- Layer 2 band -->
          <rect x="10" y="266" width="940" height="80" rx="10" fill="#fff7ed" stroke="#fed7aa" stroke-width="1"/>
          <text x="20" y="283" font-size="8.5" fill="#c2410c" font-weight="700" letter-spacing="0.08em">
            LAYER 2 — 國防航太大廠
          </text>

          <!-- Layer 3 band -->
          <rect x="10" y="386" width="940" height="80" rx="10" fill="#faf5ff" stroke="#e9d5ff" stroke-width="1"/>
          <text x="20" y="403" font-size="8.5" fill="#7c3aed" font-weight="700" letter-spacing="0.08em">
            LAYER 3 — 衛星通訊與應用
          </text>

          <!-- Layer 4 band -->
          <rect x="10" y="506" width="940" height="80" rx="10" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
          <text x="20" y="523" font-size="8.5" fill="#475569" font-weight="700" letter-spacing="0.08em">
            LAYER 4 — 關鍵零組件
          </text>

          <!-- Edges -->
          {edges.map((e: any) => {
            const st = edgeStyle[e.type] ?? edgeStyle.supplies_to;
            const d = edgePath(e.from, e.to, e.type);
            if (!d) return null;
            return (
              <path
                d={d}
                fill="none"
                stroke={st.stroke}
                stroke-width={st.width}
                stroke-dasharray={st.dash || undefined}
                marker-end={st.marker}
                opacity="0.5"
              />
            );
          })}

          <!-- Nodes -->
          {nodes.map((n: any) => {
            const p = pos[n.id];
            if (!p) return null;
            const c = getColor(n);
            const nx = p.cx - NW2;
            const ny = p.cy - NH2;
            const showTicker = n.ticker && n.ticker !== n.id && n.ticker !== n.name;
            return (
              <g>
                <rect x={nx} y={ny} width={NW} height={NH} rx="7"
                      fill={c.fill} stroke={c.stroke} stroke-width="1.5"/>
                <text x={p.cx} y={p.cy - 5} text-anchor="middle"
                      font-size="11.5" font-weight="700" fill={c.text}>
                  {n.name}{showTicker ? ` (${n.ticker})` : ''}
                </text>
                <text x={p.cx} y={p.cy + 11} text-anchor="middle"
                      font-size="8.5" fill={c.text} opacity="0.72">
                  {n.desc}
                </text>
              </g>
            );
          })}

          <text x="950" y="614" text-anchor="end" font-size="8" fill="#d1d5db" letter-spacing="0.05em">
            © Xompass Research
          </text>
        </svg>
      </div>

      <div class="legend">
        {legend.map((item: any) => (
          <div class="legend-item">
            <svg width="36" height="12" viewBox="0 0 36 12" fill="none">
              {item.dash
                ? <line x1="0" y1="6" x2="32" y2="6" stroke={item.color} stroke-width="2" stroke-dasharray="7 3"/>
                : <line x1="0" y1="6" x2="32" y2="6" stroke={item.color} stroke-width="2"/>
              }
              <polygon points="29,3 36,6 29,9" fill={item.color}/>
            </svg>
            <span>{item.label}</span>
          </div>
        ))}
        <div style="margin-left: auto; color: #9ca3af; font-size: 0.72rem; display:flex; align-items:center;">
          資料來源：公開財報、產業研究 — 僅供參考，不構成投資建議
        </div>
      </div>

      <p class="note">每季更新 · 如有疑問請來信 bargisula@gmail.com</p>

    </main>
    <Footer />
  </body>
</html>
