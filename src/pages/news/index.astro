---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import marketData from '../../data/market.json';

const allNotes = (await getCollection('notes'))
  .filter(n => n.data.category === '投資')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const { updated, indices } = marketData;

const TABS = [
  { id: 'all',     label: '全部',   match: () => true },
  { id: '美股',    label: '美股',   match: (n: any) => n.data.subcategory?.includes('美股') },
  { id: '台股',    label: '台股',   match: (n: any) => n.data.subcategory?.includes('台股') },
  { id: '盤報',    label: '盤報',   match: (n: any) => ['盤前','盤後'].includes(n.data.topic ?? '') },
  { id: '快訊',    label: '快訊',   match: (n: any) => ['美股快報','台股快報','市場快訊'].includes(n.data.topic ?? '') },
  { id: '產業',    label: '產業',   match: (n: any) => ['產業分析','AI基礎設施','快篩','太空資料中心','AI'].includes(n.data.topic ?? '') },
  { id: '理財',    label: '理財',   match: (n: any) => n.data.subcategory?.includes('理財日報') || n.data.subcategory?.includes('其他投資') },
];

const tabNotes = TABS.map(tab => ({
  ...tab,
  notes: allNotes.filter(tab.match),
}));

type SubCatStyle = { bg: string; color: string; border: string; dot: string };
const subStyles: Record<string, SubCatStyle> = {
  '美股':     { bg: '#eff6ff', color: '#1d4ed8', border: '#bfdbfe', dot: '#3b82f6' },
  '台股':     { bg: '#f0fdf4', color: '#15803d', border: '#bbf7d0', dot: '#22c55e' },
  '理財日報': { bg: '#fff7ed', color: '#c2410c', border: '#fed7aa', dot: '#f97316' },
  '總經':     { bg: '#f5f3ff', color: '#6d28d9', border: '#ddd6fe', dot: '#8b5cf6' },
  '總經速描': { bg: '#f5f3ff', color: '#6d28d9', border: '#ddd6fe', dot: '#8b5cf6' },
  '當月快訊': { bg: '#fef9c3', color: '#854d0e', border: '#fde68a', dot: '#eab308' },
  '其他投資': { bg: '#f0f9ff', color: '#0369a1', border: '#bae6fd', dot: '#0ea5e9' },
  '黃金':     { bg: '#fefce8', color: '#713f12', border: '#fef08a', dot: '#ca8a04' },
};
function getStyle(sub?: string): SubCatStyle {
  return subStyles[sub ?? ''] ?? { bg: '#f8fafc', color: '#475569', border: '#e2e8f0', dot: '#94a3b8' };
}

function topicLabel(note: any): string {
  if (note.data.topic) return note.data.topic;
  return note.data.subcategory ?? '投資';
}

function fmt(n: number | null, dec = 2) {
  if (n == null || isNaN(n)) return '--';
  return n.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });
}
const dateLabel = updated ? updated.slice(5).replace('-', '/') : '--/--';

function dayLabel(d: Date): string {
  const today = new Date();
  const diff = Math.floor((today.getTime() - d.getTime()) / 86400000);
  if (diff === 0) return '今日';
  if (diff === 1) return '昨日';
  if (diff < 7) return `${diff}天前`;
  return '';
}
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={`財經快訊 | ${SITE_TITLE}`} description="最新投資分析、市場快報、產業研究精選" />
  </head>
  <body>
    <Header />

    <main class="news-main">

      <!-- Market Banner -->
      <div class="market-banner">
        <div class="market-banner-inner">
          <span class="market-label">美股收盤 {dateLabel}</span>
          <div class="market-indices">
            {indices.map((idx) => (
              <span class="market-item">
                <span class="idx-name">{idx.name}</span>
                <span class="idx-val">{idx.name === '道瓊' ? fmt(idx.close, 0) : fmt(idx.close, 2)}</span>
                <span class={`idx-chg ${(idx.change ?? 0) >= 0 ? 'up' : 'down'}`}>
                  {(idx.change ?? 0) >= 0 ? '▲' : '▼'}{idx.pct != null ? fmt(Math.abs(idx.pct), 2) : '--'}%
                </span>
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Page Title -->
      <div class="page-title-row">
        <h1 class="page-title">財經快訊</h1>
        <span class="total-count">{allNotes.length} 篇報告</span>
      </div>

      <!-- Category Tabs -->
      <div class="tabs-wrap">
        <div class="tabs" id="news-tabs">
          {TABS.map((tab, i) => (
            <button
              class={`tab-btn${i === 0 ? ' active' : ''}`}
              data-tab={tab.id}
              data-count={tabNotes[i].notes.length}
            >
              {tab.label}
              <span class="tab-count">{tabNotes[i].notes.length}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Feed Sections (one per tab, all rendered, JS toggles visibility) -->
      {tabNotes.map((tab, tabIdx) => (
        <section
          class={`feed-section${tabIdx === 0 ? ' active' : ''}`}
          data-feed={tab.id}
        >
          {tab.notes.length === 0 ? (
            <div class="empty-state">
              <span class="empty-icon">📭</span>
              <p>此分類暫無文章</p>
            </div>
          ) : (
            <>
              {/* Featured: first article */}
              <a href={`/notes/${tab.notes[0].id}/`} class="featured-card">
                <div class="featured-meta">
                  <span
                    class="cat-pill"
                    style={`background:${getStyle(tab.notes[0].data.subcategory).bg};color:${getStyle(tab.notes[0].data.subcategory).color};border-color:${getStyle(tab.notes[0].data.subcategory).border}`}
                  >
                    {topicLabel(tab.notes[0])}
                  </span>
                  {dayLabel(new Date(tab.notes[0].data.pubDate)) && (
                    <span class="day-badge">{dayLabel(new Date(tab.notes[0].data.pubDate))}</span>
                  )}
                  <time class="featured-date"><FormattedDate date={tab.notes[0].data.pubDate} /></time>
                </div>
                <h2 class="featured-title">{tab.notes[0].data.title}</h2>
                <p class="featured-desc">{tab.notes[0].data.description}</p>
                <span class="read-more">閱讀全文 →</span>
              </a>

              {/* Rest: news grid */}
              {tab.notes.length > 1 && (
                <div class="news-grid">
                  {tab.notes.slice(1).map((note) => {
                    const style = getStyle(note.data.subcategory);
                    return (
                      <a href={`/notes/${note.id}/`} class="news-card">
                        <div class="card-top">
                          <span
                            class="cat-pill small"
                            style={`background:${style.bg};color:${style.color};border-color:${style.border}`}
                          >
                            {topicLabel(note)}
                          </span>
                          <time class="card-date"><FormattedDate date={note.data.pubDate} /></time>
                        </div>
                        <h3 class="card-title">{note.data.title}</h3>
                        <p class="card-desc">{note.data.description}</p>
                        <div class="card-footer">
                          <span class="card-dot" style={`background:${style.dot}`}></span>
                          <span class="card-sub">{note.data.subcategory}</span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}
            </>
          )}
        </section>
      ))}

    </main>

    <Footer />
  </body>
</html>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const feeds = document.querySelectorAll<HTMLElement>('.feed-section');

  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.tab!;
      tabs.forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      feeds.forEach(f => {
        f.classList.toggle('active', f.dataset.feed === id);
      });
    });
  });
</script>

<style>
  .news-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1em 4em;
  }

  /* ── Market Banner ── */
  .market-banner {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: white;
    border-radius: 12px;
    padding: 0.75em 1.4em;
    margin-bottom: 1.5em;
    margin-top: 1.5em;
  }
  .market-banner-inner {
    display: flex;
    align-items: center;
    gap: 1.2em;
    flex-wrap: wrap;
  }
  .market-label {
    font-size: 0.78em;
    color: #94a3b8;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .market-indices {
    display: flex;
    gap: 1.5em;
    flex-wrap: wrap;
  }
  .market-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.85em;
    white-space: nowrap;
  }
  .idx-name { color: #94a3b8; font-size: 0.9em; }
  .idx-val  { color: #f1f5f9; font-weight: 600; font-variant-numeric: tabular-nums; }
  .idx-chg  { font-weight: 700; font-variant-numeric: tabular-nums; font-size: 0.9em; }
  .idx-chg.up   { color: #4ade80; }
  .idx-chg.down { color: #f87171; }

  /* ── Page Title ── */
  .page-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.8em;
    margin-bottom: 1em;
  }
  .page-title {
    font-size: 1.6em;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .total-count {
    font-size: 0.85em;
    color: rgb(var(--gray));
  }

  /* ── Tabs ── */
  .tabs-wrap {
    position: sticky;
    top: 60px;
    z-index: 50;
    background: #f8fafc;
    padding: 0.5em 0;
    margin-bottom: 1.5em;
    border-bottom: 1px solid var(--border);
  }
  .tabs {
    display: flex;
    gap: 0.25em;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 2px;
  }
  .tabs::-webkit-scrollbar { display: none; }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.45em 1.1em;
    border: 1px solid transparent;
    border-radius: 20px;
    font-size: 0.88em;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    background: transparent;
    color: rgb(var(--gray));
    transition: all 0.15s;
    font-family: inherit;
  }
  .tab-btn:hover {
    background: var(--accent-light);
    color: var(--accent);
  }
  .tab-btn.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }
  .tab-count {
    font-size: 0.78em;
    background: rgba(0,0,0,0.1);
    padding: 0.1em 0.4em;
    border-radius: 10px;
    font-weight: 500;
  }
  .tab-btn.active .tab-count {
    background: rgba(255,255,255,0.25);
  }

  /* ── Feed Sections ── */
  .feed-section { display: none; }
  .feed-section.active { display: block; }

  /* ── Featured Card ── */
  .featured-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.8em 2em;
    margin-bottom: 1.5em;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }
  .featured-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), #8b5cf6);
  }
  .featured-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    border-color: var(--accent);
  }
  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.7em;
    margin-bottom: 0.8em;
    flex-wrap: wrap;
  }
  .featured-title {
    font-size: 1.4em;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 0.6em;
    color: rgb(var(--black));
    letter-spacing: -0.02em;
  }
  .featured-card:hover .featured-title { color: var(--accent); }
  .featured-desc {
    color: rgb(var(--gray));
    font-size: 0.95em;
    line-height: 1.7;
    margin: 0 0 1em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .featured-date {
    font-size: 0.82em;
    color: rgb(var(--gray));
  }
  .read-more {
    font-size: 0.88em;
    font-weight: 600;
    color: var(--accent);
  }
  .day-badge {
    display: inline-block;
    font-size: 0.75em;
    font-weight: 700;
    padding: 0.15em 0.55em;
    border-radius: 4px;
    background: #fef3c7;
    color: #92400e;
    letter-spacing: 0.02em;
  }

  /* ── Category Pill ── */
  .cat-pill {
    display: inline-block;
    font-size: 0.78em;
    font-weight: 600;
    padding: 0.2em 0.65em;
    border-radius: 4px;
    border: 1px solid;
    white-space: nowrap;
  }
  .cat-pill.small {
    font-size: 0.72em;
    padding: 0.15em 0.5em;
  }

  /* ── News Grid ── */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25em;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.2em 1.4em;
    transition: all 0.18s;
  }
  .news-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    border-color: var(--accent);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.7em;
    gap: 0.5em;
  }
  .card-date {
    font-size: 0.75em;
    color: rgb(var(--gray));
    white-space: nowrap;
    flex-shrink: 0;
  }
  .card-title {
    font-size: 0.97em;
    font-weight: 700;
    line-height: 1.45;
    margin: 0 0 0.5em;
    color: rgb(var(--black));
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .news-card:hover .card-title { color: var(--accent); }
  .card-desc {
    font-size: 0.82em;
    color: rgb(var(--gray));
    line-height: 1.6;
    margin: 0 0 0.8em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-top: auto;
  }
  .card-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .card-sub {
    font-size: 0.75em;
    color: rgb(var(--gray));
  }

  /* ── Empty State ── */
  .empty-state {
    text-align: center;
    padding: 4em 2em;
    color: rgb(var(--gray));
  }
  .empty-icon { font-size: 2.5em; display: block; margin-bottom: 0.5em; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .news-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .news-grid { grid-template-columns: 1fr; }
    .featured-title { font-size: 1.2em; }
    .featured-card { padding: 1.4em 1.2em; }
    .market-banner { padding: 0.65em 1em; }
    .market-indices { gap: 1em; }
    .page-title { font-size: 1.35em; }
  }
</style>
