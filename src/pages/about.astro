---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={`關於 | ${SITE_TITLE}`} description="關於 Alpha Huang 與這個部落格" />
  </head>
  <body>
    <Header />
    <main>
      <div class="about-container">
        <div class="about-header">
          <div class="avatar">α</div>
          <div>
            <h1>Alpha Huang</h1>
            <p class="tagline">經濟史研究者 · 系統拆解者 · 科學思維實踐者</p>
          </div>
        </div>

        <div class="prose">
          <h2>關於這個部落格</h2>
          <p>
            Alpha Notes 是我用來拆解世界的工具。我感興趣的問題都有一個共同點：「為什麼會這樣？」
            ——為什麼某些文明比其他文明更早工業化，為什麼大腦會用特定方式做決策，
            為什麼市場在理論上應該有效但現實上一再失效。
          </p>
          <p>
            寫作是逼自己把思路說清楚的方式。沒辦法寫清楚，就代表還沒想清楚。
          </p>

          <h2>關注領域</h2>
          <ul>
            <li>
              <strong>長時間跨度的經濟發展</strong> —
              文明為什麼分歧？工業革命為什麼在英格蘭？從百年尺度看制度、地理、能源、文化如何共同決定財富的積累與消耗。
            </li>
            <li>
              <strong>拆解系統</strong> —
              心理、大腦、物理、投資市場、軍事戰略，本質上都是複雜系統的不同面貌。比起記憶結論，更在乎用科學方法找到每個系統的底層邏輯。
            </li>
            <li>
              <strong>投資與市場</strong> —
              以總體經濟為基礎，用數量化方式驗證直覺，持續修正模型。
            </li>
            <li>
              <strong>開源開發</strong> —
              把思考工具化，用程式讓框架能跑起來、被驗證、被複用。
            </li>
            <li>
              <strong>AI 工具使用經驗</strong> —
              使用過：Gemini APP(連結google工具)、Gemini AI Studio、AGY(CLI)、antigravity(桌面板)、CLAUDE CODE、CODEX、Github Copilot(桌面板)、Copilot Github CLI、Copilot(網頁)、META AI(網頁)、GROK(網頁)、Mistral(網頁)、GPT(網頁)、Ollama
            </li>
          </ul>

          <h2>聯絡</h2>
          <p>
            可以在 <a href="https://github.com/bargisula" target="_blank">GitHub</a> 找到我。
          </p>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .about-container {
    max-width: 720px;
    margin: 0 auto;
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: 1.5em;
    margin-bottom: 2em;
    padding: 2em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .avatar {
    width: 72px;
    height: 72px;
    min-width: 72px;
    background: var(--accent);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2em;
    font-weight: 700;
  }

  .about-header h1 {
    font-size: 1.6em;
    margin: 0 0 0.2em;
  }

  .tagline {
    color: rgb(var(--gray));
    margin: 0;
    font-size: 0.95em;
  }

  .prose {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2em 2.5em;
  }

  .prose h2 {
    font-size: 1.2em;
    margin-top: 2em;
    padding-bottom: 0.4em;
    border-bottom: 2px solid var(--accent-light);
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .prose ul {
    padding-left: 1.2em;
  }

  .prose li {
    margin-bottom: 0.4em;
  }

  @media (max-width: 560px) {
    .about-header { flex-direction: column; text-align: center; }
    .prose { padding: 1.5em; }
  }
</style>
