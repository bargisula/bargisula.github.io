---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import graphData from '../../data/knowledge/power-infra-nodes.json';

const { title, subtitle, version, last_updated, nodes, edges, legend } = graphData;

// ── 節點排版位置 ─────────────────────────────────────────────────────────────
// Layer 0A 核電/SMR（cy=72）：3 節點，均分全寬
// Layer 0B 傳統/再生（cy=150）：4 節點，均分全寬
// Layer 1  電網設備（cy=280）：4 節點
// Layer 2  機房電源（cy=410）：3 節點
// Layer 3  Hyperscaler（cy=538）：4 節點
const NW  = 130;
const NH  = 52;
const NW2 = NW / 2;
const NH2 = NH / 2;

const pos: Record<string, { cx: number; cy: number }> = {
  // Layer 0A — 核電 / SMR（band y=24, cy=72）
  CEG:   { cx: 160, cy: 72  },
  OKLO:  { cx: 480, cy: 72  },
  CCJ:   { cx: 800, cy: 72  },
  // Layer 0B — 傳統 / 再生能源（cy=150）
  VST:   { cx: 120, cy: 150 },
  NRG:   { cx: 360, cy: 150 },
  BE:    { cx: 600, cy: 150 },
  NEE:   { cx: 840, cy: 150 },
  // Layer 1 — 電網基礎設備（band y=192, cy=280）
  GEV:   { cx: 120, cy: 268 },
  ETN:   { cx: 360, cy: 268 },
  PWR:   { cx: 600, cy: 268 },
  HUBB:  { cx: 840, cy: 268 },
  // Layer 2 — 機房電源管理（band y=320, cy=410）
  VRT:   { cx: 160, cy: 400 },
  SBGSY: { cx: 480, cy: 400 },
  SMCI:  { cx: 800, cy: 400 },
  // Layer 3 — Hyperscaler（band y=450, cy=538）
  MSFT:  { cx: 120, cy: 530 },
  AMZN:  { cx: 360, cy: 530 },
  GOOG:  { cx: 600, cy: 530 },
  META:  { cx: 840, cy: 530 },
};

// ── 邊線樣式 ────────────────────────────────────────────────────────────────
const edgeStyle: Record<string, { stroke: string; width: number; dash: string; marker: string }> = {
  ppa:        { stroke: '#0ea5e9', width: 1.5, dash: '6 3', marker: 'url(#arr-blue)'   },
  supplies_to:{ stroke: '#9ca3af', width: 1.2, dash: '',    marker: 'url(#arr-gray)'   },
  investment: { stroke: '#ea580c', width: 2,   dash: '7 3', marker: 'url(#arr-orange)' },
  competition:{ stroke: '#7c3aed', width: 1.5, dash: '5 3', marker: 'url(#arr-purple)' },
};

// ── 節點顏色 ─────────────────────────────────────────────────────────────────
const nodeColor: Record<string, { fill: string; stroke: string; text: string }> = {
  '0A': { fill: '#f0fdf4', stroke: '#15803d', text: '#14532d' }, // deep green — 核電/SMR
  '0B': { fill: '#fefce8', stroke: '#b45309', text: '#713f12' }, // amber — 傳統/再生
  '1':  { fill: '#eff6ff', stroke: '#2563eb', text: '#1e3a8a' }, // blue  — 電網設備
  '2':  { fill: '#faf5ff', stroke: '#7c3aed', text: '#4c1d95' }, // purple — 機房電源
  '3':  { fill: '#fff7ed', stroke: '#c2410c', text: '#7c2d12' }, // orange — Hyperscaler
};
function getColor(n: any) {
  return nodeColor[n.sublayer ?? n.layer] ?? nodeColor['3'];
}

// ── 邊線路徑 ─────────────────────────────────────────────────────────────────
function edgePath(fromId: string, toId: string, type: string): string {
  const s = pos[fromId];
  const t = pos[toId];
  if (!s || !t) return '';

  if (type === 'competition') {
    const arc = Math.max(s.cy, t.cy) + 44;
    return `M ${s.cx} ${s.cy + NH2} C ${s.cx} ${arc} ${t.cx} ${arc} ${t.cx} ${t.cy + NH2}`;
  }
  if (type === 'investment') {
    if (s.cy > t.cy) {
      // upward: route along right margin
      return `M ${s.cx + NW2} ${s.cy} C 955 ${s.cy} 955 ${t.cy} ${t.cx + NW2} ${t.cy}`;
    }
    const arc = Math.min(s.cy, t.cy) - 36;
    return `M ${s.cx + NW2} ${s.cy} C ${s.cx + NW2 + 50} ${arc} ${t.cx - NW2 - 50} ${arc} ${t.cx - NW2} ${t.cy}`;
  }

  // Default: top→bottom bezier (ppa & supplies_to)
  const x1 = s.cx, y1 = s.cy + NH2;
  const x2 = t.cx, y2 = t.cy - NH2;
  const dy = (y2 - y1) * 0.4;
  return `M ${x1} ${y1} C ${x1} ${y1 + dy} ${x2} ${y2 - dy} ${x2} ${y2}`;
}
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead
      title={`${title} — Xompass`}
      description={subtitle}
    />
    <style>
      body { background: #f9fafb; }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

      .page-header { margin-bottom: 1.5rem; }
      .page-header h1 {
        font-size: 1.6rem; font-weight: 800; color: #111827;
        margin: 0 0 0.35rem; letter-spacing: -0.03em;
      }
      .subtitle { color: #6b7280; font-size: 0.9rem; margin: 0 0 0.6rem; }
      .meta { display: flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; color: #9ca3af; }
      .version {
        background: #e0f2fe; color: #0369a1;
        padding: 0.15rem 0.5rem; border-radius: 20px;
        font-weight: 600; font-size: 0.72rem;
      }
      .sep { color: #d1d5db; }

      .description {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-left: 4px solid #0ea5e9;
        border-radius: 8px;
        padding: 1.1rem 1.4rem;
        margin-bottom: 1.4rem;
        font-size: 0.875rem; color: #374151; line-height: 1.75;
      }
      .description p { margin: 0 0 0.7rem; }
      .description p:last-child { margin: 0; }
      .layers {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.6rem; margin-top: 0.9rem;
      }
      .layer-chip {
        display: flex; align-items: flex-start; gap: 0.5rem;
        background: #f9fafb; border: 1px solid #e5e7eb;
        border-radius: 6px; padding: 0.55rem 0.75rem;
        font-size: 0.8rem; line-height: 1.5;
      }
      .layer-chip .dot {
        width: 10px; height: 10px; border-radius: 50%;
        flex-shrink: 0; margin-top: 3px;
      }
      .layer-chip strong { display: block; font-size: 0.78rem; color: #111827; }
      .layer-chip span { color: #6b7280; font-size: 0.77rem; }

      .graph-container {
        background: #fff; border: 1px solid #e5e7eb;
        border-radius: 12px; padding: 1rem;
        overflow-x: auto;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
      }
      .graph-container svg { display: block; min-width: 760px; }

      .legend {
        display: flex; flex-wrap: wrap; gap: 1.2rem;
        margin-top: 1.2rem; padding: 0.9rem 1.2rem;
        background: #fff; border: 1px solid #e5e7eb;
        border-radius: 10px; font-size: 0.8rem; color: #374151;
      }
      .legend-item { display: flex; align-items: center; gap: 0.45rem; }
      .legend-item svg { flex-shrink: 0; }
      .note { margin-top: 1rem; font-size: 0.75rem; color: #9ca3af; text-align: right; }

      @media (max-width: 640px) {
        main { padding: 1rem 0.75rem 3rem; }
        .page-header h1 { font-size: 1.2rem; }
        .layers { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>

      <div class="page-header">
        <h1>{title}</h1>
        <p class="subtitle">{subtitle}</p>
        <div class="meta">
          <span class="version">{version}</span>
          <span class="sep">·</span>
          <span>更新日期 {last_updated}</span>
          <span class="sep">·</span>
          <span>Xompass Research</span>
        </div>
      </div>

      <div class="description">
        <p>
          AI 模型訓練與推論消耗的電力正在成為整個算力產業的<strong>真正瓶頸</strong>。
          本圖呈現從電力來源到機房端的供應鏈，
          以及 Hyperscaler 如何透過 PPA 合約與直接投資，反向鎖定上游電力資源。
          <strong>藍色虛線為 PPA 電力購買協議</strong>，橙色虛線為資本投資回流。
        </p>
        <div class="layers">
          <div class="layer-chip">
            <span class="dot" style="background:#15803d;"></span>
            <div>
              <strong>Layer 0A — 核電 / SMR</strong>
              <span>CEG 是最大清潔核電 PPA 簽約方；Oklo（OKLO）是 Sam Altman 投資的 SMR 新創，已與 AI 資料中心簽署供電 LOI；Cameco（CCJ）是全球最大鈾礦商，為核電廠提供燃料，是核電鏈最上游。</span>
            </div>
          </div>
          <div class="layer-chip">
            <span class="dot" style="background:#b45309;"></span>
            <div>
              <strong>Layer 0B — 傳統 / 再生能源</strong>
              <span>VST（天然氣＋核電）與 NRG（天然氣）在 AI 電力需求下重獲資本市場關注；BE 燃料電池提供機房側現場發電；NEE 是全球最大風電與太陽能運營商。</span>
            </div>
          </div>
          <div class="layer-chip">
            <span class="dot" style="background:#2563eb;"></span>
            <div>
              <strong>Layer 1 — 電網基礎設備</strong>
              <span>GEV 變壓器交期長達 2 年，是最直接的供應瓶頸；ETN 電力分配設備；PWR 電力基礎設施工程商；HUBB 電氣連接件。</span>
            </div>
          </div>
          <div class="layer-chip">
            <span class="dot" style="background:#7c3aed;"></span>
            <div>
              <strong>Layer 2 — 機房電源管理</strong>
              <span>VRT（Vertiv）是資料中心電源與冷卻龍頭；Schneider（SBGSY）EcoStruxure 軟硬整合；SMCI 液冷高密度伺服器機架。</span>
            </div>
          </div>
          <div class="layer-chip">
            <span class="dot" style="background:#c2410c;"></span>
            <div>
              <strong>Layer 3 — 需求端 Hyperscaler</strong>
              <span>MSFT / AMZN / GOOG / META 四大雲端商 2026 年合計 AI capex 逾 2,500 億美元，反向投資發電資產以鎖定電力，確保 AI 擴張不受電力限制。</span>
            </div>
          </div>
        </div>
      </div>

      <div class="graph-container">
        <svg
          viewBox="0 0 960 620"
          width="100%"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label={title}
          style="font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;"
        >
          <defs>
            <marker id="arr-blue"   viewBox="0 0 10 8" refX="9" refY="4" markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#0ea5e9"/>
            </marker>
            <marker id="arr-gray"   viewBox="0 0 10 8" refX="9" refY="4" markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#9ca3af"/>
            </marker>
            <marker id="arr-orange" viewBox="0 0 10 8" refX="9" refY="4" markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#ea580c"/>
            </marker>
            <marker id="arr-purple"    viewBox="0 0 10 8" refX="9" refY="4" markerWidth="5" markerHeight="5" orient="auto">
              <path d="M0 0L10 4L0 8z" fill="#7c3aed"/>
            </marker>
          </defs>

          <!-- Layer 0 band（含 0A + 0B 兩排）-->
          <rect x="10" y="20" width="940" height="164" rx="10"
                fill="#f7fef9" stroke="#bbf7d0" stroke-width="1"/>
          <text x="20" y="38" font-size="8.5" fill="#15803d" font-weight="700" letter-spacing="0.08em">
            LAYER 0 — 發電（Generation）
          </text>
          <!-- 0A / 0B 分隔線 -->
          <line x1="30" y1="116" x2="930" y2="116"
                stroke="#d1fae5" stroke-width="1" stroke-dasharray="4 3"/>
          <text x="20" y="112" font-size="7.5" fill="#15803d" opacity="0.7">
            0A — 核電 / SMR
          </text>
          <text x="20" y="130" font-size="7.5" fill="#b45309" opacity="0.7">
            0B — 傳統 / 再生能源
          </text>

          <!-- Layer 1 band -->
          <rect x="10" y="200" width="940" height="110" rx="10"
                fill="#eff6ff" stroke="#bfdbfe" stroke-width="1"/>
          <text x="20" y="218" font-size="8.5" fill="#2563eb" font-weight="700" letter-spacing="0.08em">
            LAYER 1 — 電網基礎設備（Grid Infrastructure）
          </text>

          <!-- Layer 2 band -->
          <rect x="10" y="328" width="940" height="100" rx="10"
                fill="#faf5ff" stroke="#ddd6fe" stroke-width="1"/>
          <text x="20" y="346" font-size="8.5" fill="#7c3aed" font-weight="700" letter-spacing="0.08em">
            LAYER 2 — 機房電源管理（Data Center Power）
          </text>

          <!-- Layer 3 band -->
          <rect x="10" y="456" width="940" height="108" rx="10"
                fill="#fff7ed" stroke="#fed7aa" stroke-width="1"/>
          <text x="20" y="474" font-size="8.5" fill="#c2410c" font-weight="700" letter-spacing="0.08em">
            LAYER 3 — 需求端（Hyperscaler）
          </text>

          <!-- Edges -->
          {edges.map((e: any) => {
            const st = edgeStyle[e.type] ?? edgeStyle.supplies_to;
            const d = edgePath(e.from, e.to, e.type);
            if (!d) return null;
            return (
              <path
                d={d}
                fill="none"
                stroke={st.stroke}
                stroke-width={st.width}
                stroke-dasharray={st.dash || undefined}
                marker-end={st.marker}
                opacity="0.45"
              />
            );
          })}

          <!-- Nodes -->
          {nodes.map((n: any) => {
            const p = pos[n.id];
            if (!p) return null;
            const c = getColor(n);
            const nx = p.cx - NW2;
            const ny = p.cy - NH2;
            return (
              <g>
                <rect x={nx} y={ny} width={NW} height={NH} rx="7"
                      fill={c.fill} stroke={c.stroke} stroke-width="1.5"/>
                <text x={p.cx} y={p.cy - 6} text-anchor="middle"
                      font-size="12.5" font-weight="700" fill={c.text}>
                  {n.name}
                </text>
                <text x={p.cx} y={p.cy + 11} text-anchor="middle"
                      font-size="9" fill={c.text} opacity="0.72">
                  {n.desc}
                </text>
              </g>
            );
          })}

          <!-- Watermark -->
          <text x="950" y="615" text-anchor="end"
                font-size="8" fill="#d1d5db" letter-spacing="0.05em">
            © Xompass Research
          </text>
        </svg>
      </div>

      <div class="legend">
        {legend.map((item: any) => (
          <div class="legend-item">
            <svg width="36" height="12" viewBox="0 0 36 12" fill="none">
              {item.dash
                ? <line x1="0" y1="6" x2="32" y2="6"
                        stroke={item.color} stroke-width="2" stroke-dasharray={item.dash}/>
                : <line x1="0" y1="6" x2="32" y2="6"
                        stroke={item.color} stroke-width="2"/>
              }
              <polygon points="29,3 36,6 29,9" fill={item.color}/>
            </svg>
            <span>{item.label}</span>
          </div>
        ))}
        <div style="margin-left: auto; color: #9ca3af; font-size: 0.72rem; display:flex; align-items:center;">
          資料來源：公開財報、產業研究 — 僅供參考，不構成投資建議
        </div>
      </div>

      <p class="note">每季更新 · 如有疑問請來信 bargisula@gmail.com</p>

    </main>
    <Footer />
  </body>
</html>
