---
import marketData from '../data/market.json';

const { updated, indices } = marketData;

// Format: "05/12"
const dateLabel = updated ? updated.slice(5).replace('-', '/') : '--/--';

function fmt(n: number | null): string {
  if (n == null || isNaN(n)) return '--';
  return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function fmtClose(n: number | null): string {
  if (n == null || isNaN(n)) return '--';
  return n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}
---

<div class="market-ticker">
  <span class="ticker-date">美股收盤 {dateLabel}</span>
  <span class="ticker-sep">·</span>
  {indices.map((idx, i) => (
    <>
      <span class="ticker-item">
        <span class="ticker-name">{idx.name}</span>
        <span class="ticker-close">{fmtClose(idx.close)}</span>
        <span class={`ticker-change ${(idx.change ?? 0) >= 0 ? 'up' : 'down'}`}>
          {(idx.change ?? 0) >= 0 ? '▲' : '▼'}
          {idx.change != null ? fmt(Math.abs(idx.change)) : '--'}
          ({(idx.change ?? 0) >= 0 ? '+' : ''}{idx.pct != null ? idx.pct.toFixed(2) : '--'}%)
        </span>
      </span>
      {i < indices.length - 1 && <span class="ticker-sep">·</span>}
    </>
  ))}
</div>

<style>
  .market-ticker {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5em 0.75em;
    margin: 0 auto 2em;
    padding: 0.55em 1.4em;
    max-width: 720px;
    background: rgba(99, 102, 241, 0.06);
    border: 1px solid rgba(99, 102, 241, 0.18);
    border-radius: 30px;
    font-size: 0.82em;
    line-height: 1;
  }

  .ticker-date {
    color: rgb(var(--gray));
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .ticker-sep {
    color: rgba(99, 102, 241, 0.35);
    font-size: 1em;
    user-select: none;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
  }

  .ticker-name {
    color: rgb(var(--gray-dark));
    font-weight: 600;
  }

  .ticker-close {
    color: rgb(var(--black));
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .ticker-change {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-size: 0.95em;
  }

  .ticker-change.up   { color: #16a34a; }
  .ticker-change.down { color: #dc2626; }

  @media (max-width: 540px) {
    .market-ticker {
      font-size: 0.76em;
      padding: 0.5em 1em;
    }
  }
</style>
